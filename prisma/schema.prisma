generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id           Int                @id @default(autoincrement()) @map("empresa_id")
  rif          String             @map("empresa_rif") @db.VarChar
  nombre       String             @map("empresa_nombre") @db.VarChar
  activo       Boolean            @map("empresa_estatus")
  tipo         String             @map("empresa_tipo") @db.VarChar
  createdAt    DateTime?          @map("created_at") @db.Timestamp(6)
  modulos      EmpresaModulo[]
  submodulos   EmpresaSubmodulo[]
  recibos      Recibo[]
  roles        Role[]
  siniestro    Siniestro[]
  usuarios     Usuario[]
  productos    Producto[]
  planes       Plan[]
  cotizaciones Cotizacion[]
  ocrs         Ocr[]
  pagos        Pago[]
  pagoMetodos  PagoMetodo[]
  emisiones    Emision[]
  productConfigs ProductConfig[]
  funeralSubmissions FuneralSubmission[]
  feeTransaccion Decimal?         @default(0) @map("empresa_fee_transaccion") @db.Decimal(10, 2)
  apiKey         String?          @unique @map("empresa_api_key") @db.VarChar(128)
  portalConfig   EmpresaPortalConfig?

  @@map("empresa")
}

model Modulo {
  id         Int             @id @default(autoincrement()) @map("modulo_id")
  nombre     String          @map("modulo_nombre") @db.VarChar
  activo     Boolean         @map("modulo_estatus")
  createdAt  DateTime?       @map("created_at") @db.Timestamp(6)
  empresas   EmpresaModulo[]
  submodulos Submodulo[]

  @@map("modulo")
}

model Submodulo {
  id       Int                @id @default(autoincrement()) @map("submodulo_id")
  nombre   String             @map("submodulo_nombre") @db.VarChar
  url      String?            @map("submodulo_url") @db.VarChar(2048)
  activo   Boolean            @map("submodulo_estatus")
  moduloId Int                @map("submodulo_modulo_id")
  modulo   Modulo             @relation(fields: [moduloId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_submodulo_modulo")
  empresas EmpresaSubmodulo[]

  @@map("submodulo")
}

model EmpresaSubmodulo {
  id             Int       @id @default(autoincrement()) @map("emsm_id")
  empresaId      Int       @map("emsm_empresa_id")
  submoduloId    Int       @map("emsm_submodulo_id")
  activo         Boolean   @map("emsm_estatus")
  tenantToken    String?   @map("emsm_tenant_token") @db.Text
  tokenExpiresAt DateTime? @map("emsm_token_expires_at") @db.Timestamp(6)
  createdAt      DateTime? @map("emsm_created_at") @db.Timestamp(6)

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_empresa_submodulo_empresa")
  submodulo Submodulo @relation(fields: [submoduloId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_empresa_submodulo_submodulo")

  @@unique([empresaId, submoduloId])
  @@map("empresa_submodulo")
}

model EmpresaModulo {
  id        Int          @id @default(autoincrement()) @map("emmo_id")
  empresaId Int          @map("emmo_empresa_id")
  moduloId  Int          @map("emmo_modulo_id")
  token     String?      @map("emmo_token") @db.VarChar
  activo    Boolean      @map("emmo_estatus")
  createdAt DateTime?    @map("emmo_created_at") @db.Timestamp(6)
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_empresa_modulo_empresa")
  modulo    Modulo       @relation(fields: [moduloId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_empresa_modulo_modulo")
  permisos  Permission[]

  @@map("empresa_modulo")
}

model Role {
  id        Int          @id @default(autoincrement()) @map("rol_id")
  nombre    String       @map("rol_nombre") @db.VarChar
  activo    Boolean      @map("rol_estatus")
  empresaId Int          @map("rol_empresa_id")
  empresa   Empresa      @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rol_empresa")
  permisos  Permission[]
  usuarios  Usuario[]

  @@unique([nombre, empresaId])
  @@map("rol")
}

model Permission {
  id              Int           @id @default(autoincrement()) @map("romo_id")
  roleId          Int           @map("romo_rol_id")
  empresaModuloId Int           @map("romo_emmo_id")
  activo          Boolean?      @map("romo_estatus")
  empresaModulo   EmpresaModulo @relation(fields: [empresaModuloId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rol_modulo_empresa_modulo")
  role            Role          @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rol_modulo_rol")

  @@map("rol_modulo")
}

// Nueva tabla para granularidad (CRUD) que intentaremos crear
model RolePermissionDetail {
  id          Int     @id @default(autoincrement())
  roleId      Int
  moduloId    Int // ID del módulo global
  submoduloId Int? // Opcional para submódulos
  canCreate   Boolean @default(false)
  canRead     Boolean @default(true)
  canUpdate   Boolean @default(false)
  canDelete   Boolean @default(false)

  @@map("rol_permiso_detalle")
}

model Recibo {
  id                     Int       @id @default(autoincrement()) @map("recibo_id")
  numero                 Int       @map("recibo_numero")
  estatus                Boolean   @map("recibo_estatus")
  monto                  Decimal   @map("recibo_monto") @db.Decimal
  fechaDesde             DateTime  @map("recibo_fecha_desde") @db.Timestamp(6)
  fechaHasta             DateTime  @map("recibo_fecha_hasta") @db.Timestamp(6)
  recibo_fecha_pago      DateTime? @db.Timestamp(6)
  recibo_fecha_anulacion DateTime? @db.Timestamp(6)
  empresaId              Int       @map("recibo_empresa_id")
  empresa                Empresa   @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_recibo_empresa")

  @@map("recibo")
}

model Siniestro {
  id                   Int       @id @default(autoincrement()) @map("siniestro_id")
  numero               Int       @map("siniestro_numero")
  fechaOcurrencia      DateTime  @map("siniestro_fecha_ocurrencia") @db.Timestamp(6)
  fechaDeclaracion     DateTime? @map("siniestro_fecha_declaracion") @db.Timestamp(6)
  siniestro_fecha_pago DateTime? @db.Timestamp(6)
  estatus              DateTime? @map("siniestro_estatus") @db.Timestamp(6)
  recibo_empresa_id    Int
  empresa              Empresa   @relation(fields: [recibo_empresa_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_siniestro_empresa")

  @@map("siniestro")
}

model Usuario {
  id        Int      @id @default(autoincrement()) @map("usuario_id")
  email     String   @unique @map("usuario_email") @db.VarChar
  password  String   @map("usuario_password") @db.VarChar
  nombre    String   @map("usuario_nombre") @db.VarChar
  empresaId Int      @map("usuario_empresa_id")
  roleId    Int      @map("usuario_role_id")
  activo    Boolean  @default(true) @map("usuario_estatus")
  createdAt DateTime @default(now()) @map("created_at")

  empresa        Empresa         @relation(fields: [empresaId], references: [id])
  role           Role            @relation(fields: [roleId], references: [id])
  portalSessions PortalSession[]
  portalPerfil   UsuarioPortalPerfil?

  @@map("usuario")
}

/// Defaults Sis2000 / marketplace por empresa (fallback si el usuario no tiene perfil).
model EmpresaPortalConfig {
  empresaId              Int     @id @map("epc_empresa_id")
  centidad               String  @default("P") @map("epc_centidad") @db.Char(1)
  citem                  String  @default("80080") @map("epc_citem") @db.VarChar(20)
  cproductor             String? @map("epc_cproductor") @db.VarChar(20)
  cusuario               String? @map("epc_cusuario") @db.VarChar(20)
  resolverGestorPorEmail Boolean @default(true) @map("epc_resolver_gestor_email")
  ccanalaltIn            String? @map("epc_ccanalalt_in") @db.VarChar(20)
  cscanalaltIn           String? @map("epc_cscanalalt_in") @db.VarChar(20)
  updatedAt              DateTime @updatedAt @map("epc_updated_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("empresa_portal_config")
}

/// Canal marketplace / Sis2000 por operador del portal (Admin).
model UsuarioPortalPerfil {
  usuarioId              Int     @id @map("upp_usuario_id")
  resolverGestorPorEmail Boolean @default(true) @map("upp_resolver_gestor_email")
  centidad               String? @map("upp_centidad") @db.Char(1)
  citem                  String? @map("upp_citem") @db.VarChar(20)
  cproductor             String? @map("upp_cproductor") @db.VarChar(20)
  cusuario               String? @map("upp_cusuario") @db.VarChar(20)
  cgestor                String? @map("upp_cgestor") @db.VarChar(50)
  ccanalaltIn            String? @map("upp_ccanalalt_in") @db.VarChar(20)
  cscanalaltIn           String? @map("upp_cscanalalt_in") @db.VarChar(20)
  updatedAt              DateTime @updatedAt @map("upp_updated_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("usuario_portal_perfil")
}

model migrations {
  id        Int    @id(map: "PK_8c82d7f526340ab734260ea46be") @default(autoincrement())
  timestamp BigInt
  name      String @db.VarChar
}

// ─── Módulos del flujo de suscripción (OCR · Formulario · Planes · Pago · Emisión) ───
// Multi-tenant: todo cuelga de `empresa`. Los FK a `cotizacion` son opcionales
// para que cada módulo pueda operar por separado o encadenado.

model Producto {
  id           Int          @id @default(autoincrement()) @map("producto_id")
  nombre       String       @map("producto_nombre") @db.VarChar
  empresaId    Int          @map("producto_empresa_id")
  createdAt    DateTime     @default(now()) @map("producto_created_at") @db.Timestamp(6)
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_empresa")
  planes       Plan[]
  cotizaciones Cotizacion[]

  @@map("producto")
}

model Plan {
  id           Int          @id @default(autoincrement()) @map("plan_id")
  nombre       String       @map("plan_nombre") @db.VarChar
  productoId   Int          @map("plan_producto_id")
  empresaId    Int          @map("plan_empresa_id")
  createdAt    DateTime     @default(now()) @map("plan_created_at") @db.Timestamp(6)
  producto     Producto     @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_plan_producto")
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_plan_empresa")
  cotizaciones Cotizacion[]

  @@map("plan")
}

model Cotizacion {
  id         Int       @id @default(autoincrement()) @map("cotizacion_id")
  empresaId  Int       @map("cotizacion_empresa_id")
  productoId Int?      @map("cotizacion_producto_id")
  planId     Int?      @map("cotizacion_plan_id")
  estado     String    @default("borrador") @map("cotizacion_estado") @db.VarChar
  jsonData   Json      @map("cotizacion_json_data") @db.JsonB
  createdAt  DateTime  @default(now()) @map("cotizacion_created_at") @db.Timestamp(6)
  updatedAt  DateTime? @updatedAt @map("cotizacion_updated_at") @db.Timestamp(6)
  empresa    Empresa   @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cotizacion_empresa")
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cotizacion_producto")
  plan       Plan?     @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cotizacion_plan")
  ocrs       Ocr[]
  pagos      Pago[]
  emisiones  Emision[]

  @@map("cotizacion")
}

model Ocr {
  id            Int         @id @default(autoincrement()) @map("ocr_id")
  empresaId     Int         @map("ocr_empresa_id")
  cotizacionId  Int?        @map("ocr_cotizacion_id")
  tipoDocumento String      @map("ocr_tipo_documento") @db.VarChar
  rutaDocumento String      @map("ocr_ruta_documento") @db.VarChar
  jsonData      Json?       @map("ocr_json_data") @db.JsonB
  createdAt     DateTime    @default(now()) @map("ocr_created_at") @db.Timestamp(6)
  empresa       Empresa     @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ocr_empresa")
  cotizacion    Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_ocr_cotizacion")

  @@map("ocr")
}

model PagoMetodo {
  id        Int      @id @default(autoincrement()) @map("pago_metodo_id")
  nombre    String   @map("pago_metodo_nombre") @db.VarChar
  empresaId Int?     @map("pago_metodo_empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_metodo_empresa")
  pagos     Pago[]

  @@map("pago_metodo")
}

model Pago {
  id              Int         @id @default(autoincrement()) @map("pago_id")
  empresaId       Int         @map("pago_empresa_id")
  cotizacionId    Int?        @map("pago_cotizacion_id")
  metodoId        Int         @map("pago_metodo_id")
  referenciaBanco String      @map("pago_referencia_banco") @db.VarChar
  monto           Decimal     @map("pago_monto") @db.Decimal(18, 2)
  moneda          String      @default("VES") @map("pago_moneda") @db.Char(3)
  estado          String      @default("pendiente") @map("pago_estado") @db.VarChar
  bancoOrigen     String?     @map("pago_banco_origen") @db.VarChar
  telefonoOrigen  String?     @map("pago_telefono_origen") @db.VarChar
  fechaPago       DateTime    @map("pago_fecha_pago") @db.Timestamp(6)
  respuestaJson   Json?       @map("pago_respuesta_json") @db.JsonB
  createdAt       DateTime    @default(now()) @map("pago_created_at") @db.Timestamp(6)
  empresa         Empresa     @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_empresa")
  cotizacion      Cotizacion? @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_cotizacion")
  metodo          PagoMetodo  @relation(fields: [metodoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pago_metodo")
  emisiones       Emision[]

  @@unique([empresaId, referenciaBanco], map: "uq_pago_empresa_referencia")
  @@map("pago")
}

model Emision {
  id           Int        @id @default(autoincrement()) @map("emision_id")
  empresaId    Int        @map("emision_empresa_id")
  cotizacionId Int        @map("emision_cotizacion_id")
  pagoId       Int?       @map("emision_pago_id")
  polizaNumero String     @map("emision_poliza_numero") @db.VarChar
  estado       String     @default("emitida") @map("emision_estado") @db.VarChar
  jsonData     Json?      @map("emision_json_data") @db.JsonB
  createdAt    DateTime   @default(now()) @map("emision_created_at") @db.Timestamp(6)
  empresa      Empresa    @relation(fields: [empresaId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emision_empresa")
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emision_cotizacion")
  pago         Pago?      @relation(fields: [pagoId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_emision_pago")

  @@map("emision")
}

// ─── Configuración paramétrica de flujo por producto ────────────────────────
// Permite activar/desactivar campos y documentos sin tocar código.
// Si no existe config para una empresa/producto/modulo, los módulos
// usan su configuración hardcoded por defecto (fallback seguro).

model ProductConfig {
  id         Int      @id @default(autoincrement()) @map("product_config_id")
  empresaId  Int      @map("product_config_empresa_id")
  producto   String   @map("product_config_producto") @db.VarChar  // "rcv" | "funerario" | "patrimoniales"
  modulo     String   @map("product_config_modulo") @db.VarChar    // "ocr" | "formulario" | "pagos"
  configJson Json     @map("product_config_json") @db.JsonB
  createdAt  DateTime @default(now()) @map("product_config_created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("product_config_updated_at") @db.Timestamp(6)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade, map: "fk_product_config_empresa")

  @@unique([empresaId, producto, modulo], map: "uq_product_config")
  @@map("product_config")
}

/// Solicitud funerario pendiente de revisión técnica (scoring + cuestionario).
model FuneralSubmission {
  id               String    @id @default(uuid()) @map("funeral_submission_id") @db.Uuid
  empresaId        Int       @map("funeral_submission_empresa_id")
  sessionId        String    @map("funeral_submission_session_id") @db.VarChar(128)
  canal            String    @default("default") @map("funeral_submission_canal") @db.VarChar(64)
  estado           String    @default("pending") @map("funeral_submission_estado") @db.VarChar(32)
  tomadorRif       String?   @map("funeral_submission_tomador_rif") @db.VarChar(32)
  tomadorNombre    String?   @map("funeral_submission_tomador_nombre") @db.VarChar(256)
  tomadorEmail     String?   @map("funeral_submission_tomador_email") @db.VarChar(256)
  cplan            String    @map("funeral_submission_cplan") @db.VarChar(16)
  planName         String?   @map("funeral_submission_plan_name") @db.VarChar(256)
  cramo            Int?      @map("funeral_submission_cramo")
  scoreTotal       Float     @default(0) @map("funeral_submission_score_total")
  scoreBreakdown   Json      @default("[]") @map("funeral_submission_score_breakdown") @db.JsonB
  healthAnswers    Json      @default("{}") @map("funeral_submission_health_answers") @db.JsonB
  snapshotJson     Json      @map("funeral_submission_snapshot") @db.JsonB
  rejectReason     String?   @map("funeral_submission_reject_reason") @db.Text
  reviewedBy       String?   @map("funeral_submission_reviewed_by") @db.VarChar(128)
  reviewedAt       DateTime? @map("funeral_submission_reviewed_at") @db.Timestamp(6)
  paymentUrl       String?   @map("funeral_submission_payment_url") @db.Text
  paymentSid       String?   @map("funeral_submission_payment_sid") @db.VarChar(128)
  paymentExpiresAt DateTime? @map("funeral_submission_payment_expires_at") @db.Timestamp(6)
  cnpoliza         String?   @map("funeral_submission_cnpoliza") @db.VarChar(64)
  cnrecibo         String?   @map("funeral_submission_cnrecibo") @db.VarChar(64)
  urlpoliza        String?   @map("funeral_submission_urlpoliza") @db.Text
  emittedAt        DateTime? @map("funeral_submission_emitted_at") @db.Timestamp(6)
  createdAt        DateTime  @default(now()) @map("funeral_submission_created_at") @db.Timestamp(6)
  updatedAt        DateTime  @updatedAt @map("funeral_submission_updated_at") @db.Timestamp(6)
  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade, map: "fk_funeral_submission_empresa")

  @@index([empresaId, estado], map: "idx_funeral_submission_empresa_estado")
  @@index([sessionId], map: "idx_funeral_submission_session")
  @@map("funeral_submission")
}

// ─── Portal La Mundial — Auditoría de accesos ────────────────────────────
// Registra logins y acciones del portal (launcher SSO).

model PortalSession {
  id        Int      @id @default(autoincrement()) @map("psess_id")
  usuarioId Int      @map("psess_usuario_id")
  ipAddress String   @default("") @map("psess_ip") @db.VarChar(64)
  userAgent String?  @map("psess_user_agent") @db.Text
  token     String   @map("psess_token") @db.Text
  expiresAt DateTime @map("psess_expires_at") @db.Timestamp(6)
  createdAt DateTime @default(now()) @map("psess_created_at") @db.Timestamp(6)

  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  auditLogs PortalAuditLog[]

  @@index([usuarioId], map: "idx_portal_session_usuario")
  @@map("portal_session")
}

model PortalAuditLog {
  id        Int      @id @default(autoincrement()) @map("paudit_id")
  sessionId Int      @map("paudit_session_id")
  accion    String   @map("paudit_accion") @db.VarChar(64)
  producto  String?  @map("paudit_producto") @db.VarChar(32)
  detalle   Json?    @map("paudit_detalle") @db.JsonB
  createdAt DateTime @default(now()) @map("paudit_created_at") @db.Timestamp(6)

  session PortalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId], map: "idx_portal_audit_session")
  @@map("portal_audit_log")
}

// ─── Monitor de expedientes Marketplace (tablas nuevas, solo aditivo) ──────
// La fuente de pólizas sigue siendo `emision`: aquí solo se guarda la llave
// (emisionId, empresa + cnpoliza) y lo que el feed no trae (estado documental,
// requisitos, intentos, exclusiones, enlaces, configuración y auditoría).

model MktExpediente {
  id                 Int       @id @default(autoincrement()) @map("mexp_id")
  empresaId          Int       @map("mexp_empresa_id")
  emisionId          Int?      @map("mexp_emision_id")
  cnpoliza           String    @map("mexp_cnpoliza") @db.VarChar(64)
  cnrecibo           String?   @map("mexp_cnrecibo") @db.VarChar(64)
  producto           String    @map("mexp_producto") @db.VarChar(32)
  cramo              Int?      @map("mexp_cramo")
  area               String    @default("desconocida") @map("mexp_area") @db.VarChar(16)
  centidad           String?   @map("mexp_centidad") @db.VarChar(1)
  citem              String?   @map("mexp_citem") @db.VarChar(32)
  cgestor            String?   @map("mexp_cgestor") @db.VarChar(50)
  ccanalalt          String?   @map("mexp_ccanalalt") @db.VarChar(32)
  cusuario           String?   @map("mexp_cusuario") @db.VarChar(32)
  xlogin             String?   @map("mexp_xlogin") @db.VarChar(100)
  /// Intermediario (cproductor) informado por la emisión; los registros anteriores lo toman de citem si centidad = P.
  cproductor         String?   @map("mexp_cproductor") @db.VarChar(32)
  estadoPago         String    @default("pagada") @map("mexp_estado_pago") @db.VarChar(16)
  estadoDocumental   String    @default("incompleto") @map("mexp_estado_documental") @db.VarChar(16)
  aseguradoKey       String?   @map("mexp_asegurado_key") @db.VarChar(120)
  aseguradoTipoDoc   String?   @map("mexp_asegurado_tipo_doc") @db.VarChar(2)
  aseguradoDocumento String?   @map("mexp_asegurado_documento") @db.VarChar(32)
  aseguradoNombre    String?   @map("mexp_asegurado_nombre") @db.VarChar(150)
  aseguradoApellido  String?   @map("mexp_asegurado_apellido") @db.VarChar(150)
  aseguradoEmail     String?   @map("mexp_asegurado_email") @db.VarChar(200)
  aseguradoTelefono  String?   @map("mexp_asegurado_telefono") @db.VarChar(40)
  snapshot           Json?     @map("mexp_snapshot") @db.JsonB
  carpetaExpediente  String?   @map("mexp_carpeta") @db.Text
  origen             String    @default("emision") @map("mexp_origen") @db.VarChar(16)
  /// false = la emisión no informó documentos (registros viejos o personas sin wizard): requisitos "sin_informacion".
  infoDocumental     Boolean   @default(true) @map("mexp_info_documental")
  etapaEnviada       Int       @default(-1) @map("mexp_etapa_enviada")
  intentos           Int       @default(0) @map("mexp_intentos")
  ultimoEnvio        DateTime? @map("mexp_ultimo_envio") @db.Timestamp(6)
  cadenciaAgotada    Boolean   @default(false) @map("mexp_cadencia_agotada")
  cambiosDetectados  Boolean   @default(false) @map("mexp_cambios_detectados")
  emitidaEn          DateTime  @map("mexp_emitida_en") @db.Timestamp(6)
  completadoEn       DateTime? @map("mexp_completado_en") @db.Timestamp(6)
  createdAt          DateTime  @default(now()) @map("mexp_created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("mexp_updated_at") @db.Timestamp(6)

  requisitos MktExpedienteRequisito[]

  @@unique([empresaId, cnpoliza], map: "uq_mkt_expediente_empresa_poliza")
  @@index([estadoDocumental, area], map: "idx_mkt_expediente_estado_area")
  @@index([emitidaEn], map: "idx_mkt_expediente_emitida")
  @@index([aseguradoKey], map: "idx_mkt_expediente_asegurado")
  @@index([emisionId], map: "idx_mkt_expediente_emision")
  @@map("mkt_expediente")
}

model MktExpedienteRequisito {
  id           Int       @id @default(autoincrement()) @map("mreq_id")
  expedienteId Int       @map("mreq_expediente_id")
  tipo         String    @map("mreq_tipo") @db.VarChar(32)
  estado       String    @default("faltante") @map("mreq_estado") @db.VarChar(16)
  motivo       String?   @map("mreq_motivo") @db.Text
  ref          String?   @map("mreq_ref") @db.Text
  origen       String?   @map("mreq_origen") @db.VarChar(16)
  ocrDatos     Json?     @map("mreq_ocr_datos") @db.JsonB
  ocrConfianza Float?    @map("mreq_ocr_confianza")
  recibidoEn   DateTime? @map("mreq_recibido_en") @db.Timestamp(6)
  validadoEn   DateTime? @map("mreq_validado_en") @db.Timestamp(6)
  validadoPor  String?   @map("mreq_validado_por") @db.VarChar(128)
  updatedAt    DateTime  @updatedAt @map("mreq_updated_at") @db.Timestamp(6)

  expediente MktExpediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade, map: "fk_mkt_requisito_expediente")

  @@unique([expedienteId, tipo], map: "uq_mkt_requisito_expediente_tipo")
  @@map("mkt_expediente_requisito")
}

/// Auditoría: eventos por expediente y eventos globales (config, técnicos) con expedienteId null.
model MktExpedienteEvento {
  id           Int      @id @default(autoincrement()) @map("mevt_id")
  expedienteId Int?     @map("mevt_expediente_id")
  tipo         String   @map("mevt_tipo") @db.VarChar(48)
  actor        String   @map("mevt_actor") @db.VarChar(128)
  detalle      Json?    @map("mevt_detalle") @db.JsonB
  createdAt    DateTime @default(now()) @map("mevt_created_at") @db.Timestamp(6)

  @@index([expedienteId], map: "idx_mkt_evento_expediente")
  @@index([tipo, createdAt], map: "idx_mkt_evento_tipo_fecha")
  @@map("mkt_expediente_evento")
}

model MktExpedienteConfig {
  clave          String   @id @map("mcfg_clave") @db.VarChar(32)
  valor          Json     @map("mcfg_valor") @db.JsonB
  actualizadoPor String?  @map("mcfg_actualizado_por") @db.VarChar(128)
  updatedAt      DateTime @updatedAt @map("mcfg_updated_at") @db.Timestamp(6)

  @@map("mkt_expediente_config")
}

model MktExpedienteExclusion {
  id                Int       @id @default(autoincrement()) @map("mexc_id")
  /// asegurado | poliza | canal | gestor | intermediario
  alcance           String    @map("mexc_alcance") @db.VarChar(16)
  /// Código excluido si el alcance es canal (ccanalalt), gestor (cgestor) o intermediario (cproductor).
  valor             String?   @map("mexc_valor") @db.VarChar(64)
  empresaId         Int?      @map("mexc_empresa_id")
  cnpoliza          String?   @map("mexc_cnpoliza") @db.VarChar(64)
  aseguradoKey      String?   @map("mexc_asegurado_key") @db.VarChar(120)
  expedienteId      Int?      @map("mexc_expediente_id")
  motivo            String    @map("mexc_motivo") @db.Text
  creadoPor         String    @map("mexc_creado_por") @db.VarChar(128)
  activo            Boolean   @default(true) @map("mexc_activo")
  eliminadoPor      String?   @map("mexc_eliminado_por") @db.VarChar(128)
  eliminadoEn       DateTime? @map("mexc_eliminado_en") @db.Timestamp(6)
  motivoEliminacion String?   @map("mexc_motivo_eliminacion") @db.Text
  createdAt         DateTime  @default(now()) @map("mexc_created_at") @db.Timestamp(6)

  @@index([activo, alcance], map: "idx_mkt_exclusion_activo")
  @@map("mkt_expediente_exclusion")
}

/// Intentos de correo (recordatorios, eventos y resumen nocturno). Destinatario solo enmascarado.
model MktExpedienteNotificacion {
  id                 Int      @id @default(autoincrement()) @map("mnot_id")
  expedienteId       Int?     @map("mnot_expediente_id")
  aseguradoKey       String?  @map("mnot_asegurado_key") @db.VarChar(120)
  tipo               String   @map("mnot_tipo") @db.VarChar(32)
  etapa              Int?     @map("mnot_etapa")
  resultado          String   @map("mnot_resultado") @db.VarChar(24)
  destinatarioMasked String?  @map("mnot_destinatario") @db.VarChar(200)
  proveedor          String?  @map("mnot_proveedor") @db.VarChar(32)
  error              String?  @map("mnot_error") @db.Text
  lote               String?  @map("mnot_lote") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("mnot_created_at") @db.Timestamp(6)

  @@index([expedienteId], map: "idx_mkt_notificacion_expediente")
  @@index([createdAt], map: "idx_mkt_notificacion_fecha")
  @@map("mkt_expediente_notificacion")
}

/// Enlace firmado del asegurado: solo se guarda el hash SHA-256 del token.
model MktExpedienteEnlace {
  id             Int       @id @default(autoincrement()) @map("menl_id")
  tokenHash      String    @unique(map: "uq_mkt_enlace_hash") @map("menl_token_hash") @db.VarChar(64)
  proposito      String    @default("carga_documental") @map("menl_proposito") @db.VarChar(32)
  aseguradoKey   String?   @map("menl_asegurado_key") @db.VarChar(120)
  expedienteIds  Json      @map("menl_expediente_ids") @db.JsonB
  expiraEn       DateTime  @map("menl_expira_en") @db.Timestamp(6)
  usadoEn        DateTime? @map("menl_usado_en") @db.Timestamp(6)
  revocadoEn     DateTime? @map("menl_revocado_en") @db.Timestamp(6)
  ultimoAccesoEn DateTime? @map("menl_ultimo_acceso_en") @db.Timestamp(6)
  accesos        Int       @default(0) @map("menl_accesos")
  createdAt      DateTime  @default(now()) @map("menl_created_at") @db.Timestamp(6)

  @@map("mkt_expediente_enlace")
}

/// Una ejecución por tarea y fecha (hora Caracas) para no repetir tras reinicios.
model MktExpedienteJobRun {
  id      Int       @id @default(autoincrement()) @map("mjob_id")
  job     String    @map("mjob_job") @db.VarChar(32)
  fecha   String    @map("mjob_fecha") @db.VarChar(48)
  origen  String    @default("auto") @map("mjob_origen") @db.VarChar(16)
  estado  String    @default("en_curso") @map("mjob_estado") @db.VarChar(16)
  inicio  DateTime  @default(now()) @map("mjob_inicio") @db.Timestamp(6)
  fin     DateTime? @map("mjob_fin") @db.Timestamp(6)
  resumen Json?     @map("mjob_resumen") @db.JsonB
  error   String?   @map("mjob_error") @db.Text

  @@unique([job, fecha], map: "uq_mkt_job_run_job_fecha")
  @@map("mkt_expediente_job_run")
}
