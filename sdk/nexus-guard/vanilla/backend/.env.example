# ── Backend Express — copiar a la raíz de tu API ──
NEXUS_API_URL=http://localhost:3092
TENANT_TOKEN_SECRET=          # mismo valor que exelixi-nexus-services
NEXUS_EXPECTED_SUBMODULO_IDS= # ID del submódulo en Nexus Admin (ej. 25)

# Opcional
NEXUS_AUTH_ENABLED=true
WHITELISTED_ORIGINS=localhost,127.0.0.1
NEXUS_BYPASS_EMPRESA_ID=1
